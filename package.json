{
  "name": "riftbard",
  "version": "1.0.0",
  "description": "RiftBard: Caretaker's Vault - Riftbound Card Collection & Deck Builder",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "start:electron": "wait-on http-get://localhost:5173/ && electron .",
    "dev": "concurrently -k \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:electron\"",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "cd backend && npm install",
    "prebuild": "npm run build:frontend && npm run build:backend",
    "build": "electron-builder build --win"
  },
  "build": {
    "appId": "com.riftbard.app",
    "productName": "RiftBard",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.cjs",
      "frontend/dist/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "backend/node_modules",
        "to": "resources/backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/.env.example",
        "to": "resources/backend/.env.example"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "riftbard.ico"
    }
  },
  "author": "David",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1"
  }
}
