{
  "name": "riftbard",
  "version": "1.0.0",
  "description": "RiftBard: Caretaker's Vault - Riftbound Card Collection & Deck Builder",
  "type": "module",
  "scripts": {
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -k \"npm run start:backend\" \"npm run start:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend"
  },
  "author": "David",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1"
  }
}
