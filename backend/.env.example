# Supabase PostgreSQL Connection String (Transaction Pooler - port 6543)
DATABASE_URL="postgresql://postgres.[TU-PROYECTO]:[TU-CONTRASEÑA]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
PORT=3001

# Clave Maestra o PIN para bloquear la bóveda (Obligatoria: solo quien la tenga podrá acceder)
VAULT_PASSWORD="mi_clave_secreta"

# Clave secreta para firmar tokens de sesión (Opcional: si se omite, se autogenera)
JWT_SECRET="un_secreto_aleatorio_muy_largo_y_seguro"
